model Category {
  id            Int                      @id @default(autoincrement())
  name          String                   @unique
  description   String?
  subCategories subCategory[]
  product       productCategory_SubCat[]
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt

  @@map("categories")
}

model subCategory {
  id         Int                      @id @default(autoincrement())
  name       String                   @unique
  categoryId Int
  product    productCategory_SubCat[]
  createdAt  DateTime                 @default(now())
  updatedAt  DateTime                 @updatedAt
  category   Category                 @relation(references: [id], fields: [categoryId], onDelete: Cascade)

  @@index([categoryId])
  @@map("sub_categories")
}

model Attributes {
  id        Int                 @id @default(autoincrement())
  name      String              @unique
  unit      String?
  Products  ProductAttributes[]
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  @@map("attributes")
}
